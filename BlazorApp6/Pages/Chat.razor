    private (string Question, string A, string B, string C, int Correct) GetCurrentQuestion()
    {
        return currentQuestionIndex switch
        {
            1 => (aiQuestions.Question1, aiQuestions.OptionA1, aiQuestions.OptionB1, aiQuestions.OptionC1, aiQuestions.CorrectAnswer1),
            2 => (aiQuestions.Question2, aiQuestions.OptionA2, aiQuestions.OptionB2, aiQuestions.OptionC2, aiQuestions.CorrectAnswer2),
            3 => (aiQuestions.Question3, aiQuestions.OptionA3, aiQuestions.OptionB3, aiQuestions.OptionC3, aiQuestions.CorrectAnswer3),
            _ => ("", "", "", "", 0)
        };
    }

    private void SelectAnswer(int answer)
    {
        if (showResult) return;

        selectedAnswer = answer;
    }

    private void ConfirmAnswer()
    {
        if (selectedAnswer == null) return;

        var q = GetCurrentQuestion();
        isCorrect = selectedAnswer == q.Correct;

        if (isCorrect == true)
            correctAnswersCount++;

        showResult = true;
    }

    private string GetAnswerClass(int option)
    {
        if (!showResult)
            return selectedAnswer == option ? "selected" : "";

        var q = GetCurrentQuestion();

        if (option == q.Correct)
            return "correct";

        if (option == selectedAnswer)
            return "wrong";

        return "";
    }

    private void NextQuestion()
    {
        currentQuestionIndex++;
        selectedAnswer = null;
        showResult = false;
        isCorrect = null;
    }

    private async Task CompleteNotRatedSwap()
    {
        await hubConnection.SendAsync("EvaluateSwap", swap, correctAnswersCount);
    }
